{
  "expo": {
    "name": "ɳSentry",
    "slug": "nsentry",
    "version": "0.1.0",
    "runtimeVersion": { "policy": "sdkVersion" },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "nsentry",
    "icon": "./assets/icon.png",
    "primaryColor": "#5B9DFF",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.nself.nsentry",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "ɳSentry sends alerts when your monitors go down and incidents open."
      }
    },
    "android": {
      "package": "dev.nself.nsentry",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030712"
      },
      "permissions": ["NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5B9DFF",
          "sounds": [],
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "eas": { "projectId": "nsentry-mobile" }
    }
  }
}
