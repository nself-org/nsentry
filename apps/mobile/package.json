{
  "name": "nsentry-mobile",
  "version": "0.1.0",
  "description": "ɳSentry — monitors, incidents, and status pages on the go. Works with sentry.nself.org or your self-hosted nSelf.",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest --config jest.config.js --passWithNoTests",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "export:check": "expo export --platform ios --output-dir .expo/export-check",
    "ci:local": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@nself/errors": "workspace:*",
    "@nself/native-bridge": "workspace:*",
    "@nself/nsentry-client": "workspace:*",
    "@nself/push-client": "workspace:*",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "~53.0.0",
    "expo-constants": "~17.1.8",
    "expo-notifications": "~0.31.0",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.2.1",
    "react": "19.0.0",
    "react-native": "0.79.7",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "3.35.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.0",
    "typescript": "^5.3.3"
  }
}
