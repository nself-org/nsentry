# apps/mobile/.env.example
# Copy to .env.local before running: cp .env.example .env.local
# .env.local is gitignored — never commit it.

# Optional build-time default API endpoint. Users can switch endpoints at any
# time in Settings (SaaS <-> custom self-hosted URL).
# SaaS:      https://api.sentry.nself.org
# Self-host: http://<your-lan-ip>:8080  (local nself stack; NOT localhost on device)
EXPO_PUBLIC_DEFAULT_API_URL=https://api.sentry.nself.org

# Environment name (development | staging | production)
APP_ENV=development

# EAS project ID (required only for EAS builds / OTA updates)
EXPO_PUBLIC_EAS_PROJECT_ID=nsentry-mobile
