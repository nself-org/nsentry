##############################################################
# WARNING: CHANGE ALL SECRETS BEFORE DEPLOYING ANYWHERE REAL
#
# The values below are EXAMPLE DEFAULTS for local development.
# They are intentionally simple and publicly known.
#
# Copy this file to .env.dev and customize:
#   cp backend/.env.example backend/.env.dev
#
# NEVER commit .env.dev (gitignored).
##############################################################

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=postgres
# WARNING: change before any non-local deploy
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nsentry
POSTGRES_PORT=5432

# =============================================================================
# Hasura GraphQL Engine
# =============================================================================
HASURA_PORT=8080
# REQUIRED: generate with: openssl rand -hex 32
HASURA_ADMIN_SECRET=nself-admin-secret

# =============================================================================
# Authentication (Hasura Auth — auth_mode: bundled)
# =============================================================================
AUTH_PORT=4000
# REQUIRED: must be 64+ chars — generate with: openssl rand -hex 64
AUTH_JWT_SECRET=replace-me-with-at-least-64-random-chars-use-openssl-rand-hex-64
AUTH_SERVER_URL=http://localhost:4000
AUTH_CLIENT_URL=http://localhost:3000
AUTH_ACCESS_TOKEN_EXPIRES_IN=900
AUTH_REFRESH_TOKEN_EXPIRES_IN=43200

# =============================================================================
# Sentry Bundle plugins (pro — ports 3831-3843)
# =============================================================================
# Pro plugins validate against the nSelf license service (fail-open, 7-day TTL).
# Get a key: https://nself.org/pricing ($0.99/mo Sentry Bundle or ɳSelf+).
NSELF_PLUGIN_LICENSE_KEY=

# Uptime monitor check scheduler floor (seconds) — dev default
UPTIME_MIN_INTERVAL_SECONDS=60

# =============================================================================
# Dev seed (scripts/seed-dev.sh)
# =============================================================================
SEED_DEV_EMAIL=dev@nself.local
SEED_DEV_PASSWORD=devpassword123
SEED_DEV_TENANT=dev
